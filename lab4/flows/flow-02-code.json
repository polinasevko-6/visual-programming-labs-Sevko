        "jsCode": "// Используем let и const\nlet name = \"Sevko\";\nconst labNumber = 4;\n\n// Создаем массив\nconst subjects = [\"n8n\", \"Docker\", \"Redis\"];\n\n// Объект\nconst result = {\n  author: name,\n  lab: labNumber,\n  subjects: []\n};\n\n// Цикл for\nfor (let i = 0; i < subjects.length; i++) {\n  // Условие if/else\n  if (subjects[i].length > 4) {\n    result.subjects.push(subjects[i] + \" (длинное)\");\n  } else {\n    result.subjects.push(subjects[i] + \" (короткое)\");\n  }\n}\n\n// Возвращаем объект с полем payload\nreturn {\n  payload: result\n};"
