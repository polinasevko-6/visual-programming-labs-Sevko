        "func": "let inputNumber = msg.payload;\n\nconst numbers = [10, 20, 30, 40, 50];\n\nconst info = {\n    author: \"Sevko\",\n    lab: \"lab2\",\n    task: \"function\"\n};\n\nlet category;\nif (typeof inputNumber === 'number') {\n    if (inputNumber > 0) {\n        category = \"положительное\";\n    } else if (inputNumber < 0) {\n        category = \"отрицательное\";\n    } else {\n        category = \"ноль\";\n    }\n} else {\n    category = \"не число\";\n}\n\nlet sum = 0;\nfor (let i = 0; i < numbers.length; i++) {\n    sum += numbers[i];\n}\n\nreturn {\n    payload: {\n        input: inputNumber,\n        category: category,\n        numbers: numbers,\n        sumOfNumbers: sum,\n        info: info\n    }\n};",
